# Optional EmailJS overrides
# The contact form already uses the public identifiers in src/components/Contact.vue.
# Set these only when you want the production build to use different EmailJS values.
# Do not put private keys here. EmailJS expects its public key in the browser.

# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
